



 <!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cinema2</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom box-shadow mb-3 py-3">
            <div class="container-fluid px-4">

                @inject Microsoft.AspNetCore.Identity.SignInManager<Microsoft.AspNetCore.Identity.IdentityUser> SignInManager
                @inject Microsoft.AspNetCore.Identity.UserManager<Microsoft.AspNetCore.Identity.IdentityUser> UserManager

                @{
                    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
                    var currentPath = Context.Request.Path.Value?.ToLower() ?? "";

                    bool isAuthPage = currentController.Equals("Account", StringComparison.OrdinalIgnoreCase) ||
                                      currentPath.Contains("account") ||
                                      currentPath.Contains("login") || 
                                      currentPath.Contains("register") ||
                                      currentPath.Contains("password");
                }

                @if (isAuthPage && !SignInManager.IsSignedIn(User))
                {
                    <a class="navbar-brand fw-bold text-warning fs-4 text-decoration-none" asp-area="" asp-controller="Account" asp-action="Login">
                        <i class="bi bi-film"></i> Cinema2
                    </a>
                }
                else
                {
                    <a class="navbar-brand fw-bold text-warning fs-4" asp-area="Customer" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-film"></i> Cinema2
                    </a>
                }

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    @if (!isAuthPage)
                    {
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Customer" asp-controller="Home" asp-action="Index">التصنيفات</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Customer" asp-controller="Cinema" asp-action="Index">السينمات</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Customer" asp-controller="Movie" asp-action="Index">الأفلام</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Customer" asp-controller="Actor" asp-action="Index">الممثلين</a>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav flex-grow-1 ms-3"></ul>
                    }

                    <ul class="navbar-nav ms-auto">
                        @if (SignInManager.IsSignedIn(User) && !isAuthPage)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white fs-5" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle me-1"></i> @User.Identity?.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" asp-area="" method="post" id="logoutForm" class="px-3 py-1 m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger border-0 bg-transparent w-100 text-end cursor-pointer">تسجيل خروج</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else if (!isAuthPage)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white fs-5" asp-area="" asp-controller="Account" asp-action="Login">دخول</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link btn btn-warning text-dark px-3 ms-2 fs-5" asp-area="" asp-controller="Account" asp-action="Register">حساب جديد</a>
                            </li>
                        }
                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="text-center py-4 text-muted border-top mt-5 bg-white">

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

<script>
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('loginSuccess') === 'true') {
        $(document).ready(function () {
            toastr.options = {
                "closeButton": true,
                "progressBar": true,
                "positionClass": "toast-bottom-left",
                "timeOut": "4000"
            };
            toastr.success('تم تسجيل دخولك بنجاح!');
        });
    }
</script>

@if (TempData["Success"] != null)
{
    <script>
        $(document).ready(function () {
            toastr.options = {
                "closeButton": true,
                "progressBar": true,
                "positionClass": "toast-bottom-left",
                "timeOut": "4000"
            };
            toastr.success('@Html.Raw(TempData["Success"])');
        });
    </script>
}

@if (TempData["Error"] != null)
{
    <script>
        $(document).ready(function () {
            toastr.options = {
                "closeButton": true,
                "progressBar": true,
                "positionClass": "toast-bottom-left",
                "timeOut": "4000"
            };
            toastr.error('@Html.Raw(TempData["Error"])');
        });
    </script>
}

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>