<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cinema2</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom box-shadow mb-3 py-3">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold text-warning fs-4" asp-controller="Movies" asp-action="Index">
                    <i class="bi bi-film"></i> Cinema2
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-3">
                        <li class="nav-item">
                            <a class="nav-link text-white fs-5" asp-controller="Categories" asp-action="Index"><i class="bi bi-tags"></i> التصنيفات</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fs-5" asp-controller="Cinemas" asp-action="Index"><i class="bi bi-building"></i> السينمات</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fs-5" asp-controller="Movies" asp-action="Index"><i class="bi bi-camera-reels"></i> الأفلام</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fs-5" asp-controller="Actors" asp-action="Index"><i class="bi bi-people"></i> الممثلين</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    @if (TempData["Success"] != null)
    {
        <script>
                $(document).ready(function () {
                    toastr.options = {
                        "closeButton": true,
                        "progressBar": true,
                        "positionClass": "toast-bottom-left",
                        "timeOut": "4000"
                    };
                    toastr.success('@Html.Raw(TempData["Success"])');
                });
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
                $(document).ready(function () {
                    toastr.options = {
                        "closeButton": true,
                        "progressBar": true,
                        "positionClass": "toast-bottom-left",
                        "timeOut": "4000"
                    };
                    toastr.error('@Html.Raw(TempData["Error"])');
                });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>