@model IEnumerable<Cinema2.Models.Category>

@{
    ViewData["Title"] = "تصنيفات الأفلام";
}

<div class="container my-4">
    <div class="mb-4">
        <h2><i class="bi bi-tags"></i> تصنيفات الأفلام</h2>
    </div>

    <div class="list-group shadow-sm">
        @foreach (var item in Model)
        {
            <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                <span class="fs-5 fw-semibold">@item.Name</span>
                <span class="badge bg-dark rounded-pill">تصنيف</span>
            </div>
        }
    </div>
</div>