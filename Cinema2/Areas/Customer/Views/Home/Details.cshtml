@model Cinema2.Models.Movie

@{
    ViewData["Title"] = Model.Name + " - تفاصيل الفيلم";
}

<div class="container my-5">
    <div class="row">
        <div class="col-md-4 mb-4">
            @if (!string.IsNullOrEmpty(Model.MainImg))
            {
                <img src="@Model.MainImg" class="img-fluid rounded shadow" alt="@Model.Name" />
            }
            else
            {
                <img src="~/images/default.png" class="img-fluid rounded shadow" alt="لا توجد صورة" />
            }
        </div>
        <div class="col-md-8">
            <h1 class="fw-bold text-dark mb-3">@Model.Name</h1>
            <p class="text-muted fs-5 mb-4">@Model.Description</p>

            <ul class="list-group list-group-flush mb-4 shadow-sm rounded">
                <li class="list-group-item"><strong>التصنيف:</strong> @Model.Category?.Name</li>
                <li class="list-group-item"><strong>السينما:</strong> @Model.Cinema?.Name</li>
                <li class="list-group-item"><strong>السعر:</strong> <span class="text-success fw-bold fs-5">@Model.Price.ToString("C")</span></li>
            </ul>

            <form action="@Url.Action("BookMovie", "Home", new { area = "Customer" })" method="post" class="mb-3">
                <input type="hidden" name="movieId" value="@Model.Id" />
                <button type="submit" class="btn btn-warning btn-lg fw-bold text-dark shadow w-100">
                    <i class="bi bi-ticket-perforated me-2"></i> تأكيد الحجز الآن
                </button>
            </form>

            <a href="@Url.Action("Index", "Home", new { area = "Customer" })" class="btn btn-secondary btn-lg w-100">
                <i class="bi bi-arrow-right me-1"></i> العودة للقائمة الرئيسية
            </a>
        </div>
    </div>
</div>