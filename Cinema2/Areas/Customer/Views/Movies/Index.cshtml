@model IEnumerable<Cinema2.Models.Movie> 
@{
    ViewData["Title"] = "الأفلام المعروضة";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-camera-reels"></i> الأفلام المعروضة</h2>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <!-- لو عندك صورة للفيلم، حط مسارها هنا -->
                    <div class="card-body">
                        <h5 class="card-title fw-bold">@item.Name</h5> 
                        <p class="card-text text-muted">@item.Description</p>
                    </div>
                    <div class="card-footer bg-white border-top-0 d-flex justify-content-between align-items-center pb-3">
                        <span class="text-success fw-bold">@item.Price $</span>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-dark btn-sm">التفاصيل والحجز</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>