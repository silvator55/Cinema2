@model Cinema2.Models.Movie

@{
    ViewData["Title"] = "إضافة فيلم جديد";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0 fw-bold"><i class="bi bi-film me-2"></i> إضافة فيلم جديد</h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label fw-bold"></label>
                        <input asp-for="Name" class="form-control" placeholder="أدخل اسم الفيلم" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Price" class="form-label fw-bold"></label>
                        <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="أدخل سعر التذكرة" />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DateTime" class="form-label fw-bold"></label>
                        <input asp-for="DateTime" type="datetime-local" class="form-control" />
                        <span asp-validation-for="DateTime" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label fw-bold"></label>
                        <select asp-for="Status" class="form-select">
                            <option value="Available">متاح (Available)</option>
                            <option value="Upcoming">قريباً (Upcoming)</option>
                            <option value="Expired">منتهي (Expired)</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label fw-bold"></label>
                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId">
                            <option value="">-- اختر التصنيف --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CinemaId" class="form-label fw-bold"></label>
                        <select asp-for="CinemaId" class="form-select" asp-items="ViewBag.CinemaId">
                            <option value="">-- اختر السينما --</option>
                        </select>
                        <span asp-validation-for="CinemaId" class="text-danger"></span>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-bold">الصورة الرئيسية للفيلم (البوستر)</label>
                        <input type="file" name="mainImageFile" class="form-control" accept="image/*" />
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Description" class="form-label fw-bold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="أدخل وصف أو قصة الفيلم"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-right me-1"></i> الرجوع للقائمة
                    </a>
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-check-circle me-1"></i> حفظ الفيلم
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}