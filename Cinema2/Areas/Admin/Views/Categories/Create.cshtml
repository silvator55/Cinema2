@model Cinema2.Models.Category

@{
    ViewData["Title"] = "إضافة تصنيف جديد";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2>إضافة تصنيف جديد</h2>
    <hr />
    <form asp-action="Create" method="post">
        <div class="mb-3">
            <label asp-for="Name" class="form-label">اسم التصنيف</label>
            <input asp-for="Name" class="form-control" placeholder="أدخل اسم التصنيف (مثلاً: أكشن، كوميدي)" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between">
            <button type="submit" class="btn btn-success">حفظ</button>
            <a asp-action="Index" class="btn btn-secondary">الرجوع للقائمة</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}