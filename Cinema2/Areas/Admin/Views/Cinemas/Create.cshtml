@model Cinema2.Models.Cinema

@{
    ViewData["Title"] = "إضافة سينما جديدة";
}

<div class="card shadow-sm border-0 my-4 style-container" style="max-width: 600px; margin: 0 auto;">
    <div class="card-header bg-dark text-white py-3">
        <h5 class="mb-0 text-warning"><i class="bi bi-plus-circle me-2"></i>إضافة سينما جديدة</h5>
    </div>
    <div class="card-body p-4">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label class="form-label fw-bold">اسم السينما</label>
                <input asp-for="Name" class="form-control" placeholder="أدخل اسم السينما" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">صورة السينما</label>
                <input type="file" name="imageFile" class="form-control" accept="image/*" />
            </div>

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-right"></i> الرجوع للقائمة</a>
                <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> حفظ</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}