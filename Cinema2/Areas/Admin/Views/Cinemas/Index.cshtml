@model IEnumerable<Cinema2.Models.Cinema>

@{
    ViewData["Title"] = "السينمات";
}

<div class="card shadow-sm border-0 my-4">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0 text-warning"><i class="bi bi-building me-2"></i>قائمة السينمات</h5>
        <a asp-action="Create" class="btn btn-warning btn-sm fw-bold">
            <i class="bi bi-plus-circle me-1"></i> إضافة سينما جديدة
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="text-center" style="width: 80px;">#</th>
                        <th>الصورة</th>
                        <th>اسم السينما</th>
                        <th class="text-center" style="width: 200px;">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int index = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center fw-bold">@(index++)</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.CinemaImg))
                                    {
                                        <img src="@item.CinemaImg" alt="@item.Name" class="rounded" style="max-width: 60px; max-height: 60px;" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">لا توجد صورة</span>
                                    }
                                </td>
                                <td class="fw-semibold">@item.Name</td>
                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm me-1">
                                        <i class="bi bi-pencil-square"></i> تعديل
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-trash"></i> حذف
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">لا توجد سينمات حالياً. قم بإضافة سينما جديدة.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>