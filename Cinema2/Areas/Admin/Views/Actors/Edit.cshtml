@model Cinema2.Models.Actor

@{
    ViewData["Title"] = "تعديل ممثل";
}

<div class="card shadow-sm border-0 my-4" style="max-width: 600px; margin: 0 auto;">
    <div class="card-header bg-dark text-white py-3">
        <h5 class="mb-0 text-warning"><i class="bi bi-pencil-square me-2"></i>تعديل بيانات الممثل</h5>
    </div>
    <div class="card-body p-4">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-bold"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ProfileImg" class="form-label fw-bold"></label>
                <input asp-for="ProfileImg" class="form-control" />
                <span asp-validation-for="ProfileImg" class="text-danger"></span>
            </div>
            <div class="d-flex justify-content-between pt-2">
                <button type="submit" class="btn btn-primary fw-bold"><i class="bi bi-check-circle me-1"></i> حفظ التعديلات</button>
                <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-right me-1"></i> الرجوع للقائمة</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}