@{
    ViewData["Title"] = "الرئيسية - لوحة التحكم";
}

<div class="row g-3 mb-4">
    <!-- كارت الأفلام -->
    <div class="col-sm-6 col-md-3">
        <div class="card h-100 shadow-sm border-0 border-start border-primary border-4">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-uppercase text-muted fw-bold mb-1">الأفلام</h6>
                        <h3 class="mb-0 text-primary fw-bold">@ViewBag.MoviesCount</h3>
                    </div>
                    <div class="bg-soft-primary rounded-circle p-3 text-primary">
                        <i class="bi bi-film fs-2"></i>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-area="Admin" asp-controller="Movies" asp-action="Index" class="btn btn-link btn-sm p-0 text-primary fw-bold text-decoration-none">
                    إدارة الأفلام <i class="bi bi-arrow-left ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-md-3">
        <div class="card h-100 shadow-sm border-0 border-start border-success border-4">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-uppercase text-muted fw-bold mb-1">السينمات</h6>
                        <h3 class="mb-0 text-success fw-bold">@ViewBag.CinemasCount</h3>
                    </div>
                    <div class="bg-soft-success rounded-circle p-3 text-success">
                        <i class="bi bi-building fs-2"></i>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-area="Admin" asp-controller="Cinemas" asp-action="Index" class="btn btn-link btn-sm p-0 text-success fw-bold text-decoration-none">
                    إدارة السينمات <i class="bi bi-arrow-left ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-md-3">
        <div class="card h-100 shadow-sm border-0 border-start border-warning border-4">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-uppercase text-muted fw-bold mb-1">الممثلين</h6>
                        <h3 class="mb-0 text-warning fw-bold">@ViewBag.ActorsCount</h3>
                    </div>
                    <div class="bg-soft-warning rounded-circle p-3 text-warning">
                        <i class="bi bi-person-badge fs-2"></i>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-area="Admin" asp-controller="Actors" asp-action="Index" class="btn btn-link btn-sm p-0 text-warning fw-bold text-decoration-none">
                    إدارة الممثلين <i class="bi bi-arrow-left ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-md-3">
        <div class="card h-100 shadow-sm border-0 border-start border-info border-4">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-uppercase text-muted fw-bold mb-1">التصنيفات</h6>
                        <h3 class="mb-0 text-info fw-bold">@ViewBag.CategoriesCount</h3>
                    </div>
                    <div class="bg-soft-info rounded-circle p-3 text-info">
                        <i class="bi bi-tags fs-2"></i>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="btn btn-link btn-sm p-0 text-info fw-bold text-decoration-none">
                    إدارة التصنيفات <i class="bi bi-arrow-left ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white fw-bold">
                <i class="bi bi-speedometer2 me-2"></i> اختصارات سريعة لإدارة النظام
            </div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2">
                    <a asp-area="Admin" asp-controller="Movies" asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-1"></i> إضافة فيلم جديد
                    </a>
                    <a asp-area="Admin" asp-controller="Cinemas" asp-action="Create" class="btn btn-success">
                        <i class="bi bi-plus-circle me-1"></i> إضافة سينما جديدة
                    </a>
                    <a asp-area="Admin" asp-controller="Actors" asp-action="Create" class="btn btn-warning text-dark">
                        <i class="bi bi-plus-circle me-1"></i> إضافة ممثل جديد
                    </a>
                    <a asp-area="Admin" asp-controller="Categories" asp-action="Create" class="btn btn-info text-white">
                        <i class="bi bi-plus-circle me-1"></i> إضافة تصنيف جديد
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>